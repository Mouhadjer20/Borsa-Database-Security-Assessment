# ============================================================
# Borsa — Environment Configuration Example
# ============================================================
# Copy this file to .env and fill in all required values.
# NEVER commit a .env file containing real credentials.
# ============================================================

# ----- Application -----
APP_ENV=development
# security mode: "secure" (default) or "vulnerable" (lab only)
APP_SECURITY_MODE=secure
APP_HOST=0.0.0.0
APP_PORT=8000

# ----- Secure-mode PostgreSQL connection -----
# Uses roles: app_readonly (reads) and app_writer (writes)
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
# "require" enforces TLS; use "disable" only for local dev without TLS support
DB_SSLMODE=require

# ----- Session / JWT -----
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax
# JWT expiry in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ----- CORS -----
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# ----- Vulnerable Lab (disabled by default) -----
# Set LAB_ENABLED=true ONLY inside the isolated VirtualBox laboratory.
# When true, all LAB_DB_* variables are required.
LAB_ENABLED=false
LAB_DB_HOST=
LAB_DB_PORT=5432
LAB_DB_NAME=
LAB_DB_USER=
LAB_DB_PASSWORD=
# Lab uses a deliberately overprivileged role (app_vulnerable)
# to demonstrate excessive-privilege scenarios.
